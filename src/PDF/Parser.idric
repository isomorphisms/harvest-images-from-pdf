module PDF.Parser

import Data.List
import Data.Vect

-- Edriç spelling policy for this project:
-- use lower snake_case and descriptive names wherever the current dialect
-- permits them. `ByteParser` and `MkByteParser` remain capitalized because
-- parameterized `choice` declarations are not implemented in Edriç yet.

public export
choice parse_error one_of
  parse_error_at_byte_offset Nat String

public export
parse_error_byte_offset : parse_error → Nat
parse_error_byte_offset (parse_error_at_byte_offset byte_offset _) = byte_offset

public export
parse_error_message : parse_error → String
parse_error_message (parse_error_at_byte_offset _ error_message) = error_message

export
Eq parse_error where
  (parse_error_at_byte_offset left_byte_offset left_error_message) ==
    (parse_error_at_byte_offset right_byte_offset right_error_message) =
      left_byte_offset == right_byte_offset && left_error_message == right_error_message

export
Show parse_error where
  show (parse_error_at_byte_offset byte_offset error_message) =
    "byte offset " ++ show byte_offset ++ ": " ++ error_message

public export
choice parser_state one_of
  parser_state_with_remaining_bytes (List Bits8) Nat

public export
parser_state_remaining_bytes : parser_state → List Bits8
parser_state_remaining_bytes (parser_state_with_remaining_bytes remaining_bytes _) = remaining_bytes

public export
parser_state_byte_offset : parser_state → Nat
parser_state_byte_offset (parser_state_with_remaining_bytes _ byte_offset) = byte_offset

public export
data ByteParser : Type → Type where
  MkByteParser :
    (parser_state → Either parse_error (result_type, parser_state)) →
    ByteParser result_type

public export
run_parser : ByteParser result_type → parser_state → Either parse_error (result_type, parser_state)
run_parser (MkByteParser parser_function) = parser_function

public export
parse_with_remaining_bytes_at_offset :
  Nat → ByteParser result_type → List Bits8 →
  Either parse_error (result_type, List Bits8)
parse_with_remaining_bytes_at_offset starting_byte_offset parser input_bytes =
  case run_parser parser (parser_state_with_remaining_bytes input_bytes starting_byte_offset) of
    Left parse_failure => Left parse_failure
    Right (parsed_value, final_parser_state) =>
      Right (parsed_value, parser_state_remaining_bytes final_parser_state)

public export
parse_with_remaining_bytes :
  ByteParser result_type → List Bits8 → Either parse_error (result_type, List Bits8)
parse_with_remaining_bytes = parse_with_remaining_bytes_at_offset 0

public export
parse_at_byte_offset :
  Nat → ByteParser result_type → List Bits8 → Either parse_error result_type
parse_at_byte_offset starting_byte_offset parser input_bytes =
  case parse_with_remaining_bytes_at_offset starting_byte_offset parser input_bytes of
    Left parse_failure => Left parse_failure
    Right (parsed_value, _) => Right parsed_value

public export
parse_bytes : ByteParser result_type → List Bits8 → Either parse_error result_type
parse_bytes = parse_at_byte_offset 0

export
Functor ByteParser where
  map transform (MkByteParser parser_function) = MkByteParser $ \current_parser_state =>
    case parser_function current_parser_state of
      Left parse_failure => Left parse_failure
      Right (parsed_value, next_parser_state) =>
        Right (transform parsed_value, next_parser_state)

export
Applicative ByteParser where
  pure value = MkByteParser $ \current_parser_state => Right (value, current_parser_state)

  (MkByteParser function_parser) <*> (MkByteParser value_parser) =
    MkByteParser $ \current_parser_state =>
      case function_parser current_parser_state of
        Left parse_failure => Left parse_failure
        Right (parsed_function, next_parser_state) =>
          case value_parser next_parser_state of
            Left parse_failure => Left parse_failure
            Right (parsed_value, final_parser_state) =>
              Right (parsed_function parsed_value, final_parser_state)

export
Monad ByteParser where
  (MkByteParser parser_function) >>= next_parser =
    MkByteParser $ \current_parser_state =>
      case parser_function current_parser_state of
        Left parse_failure => Left parse_failure
        Right (parsed_value, next_parser_state) =>
          run_parser (next_parser parsed_value) next_parser_state

public export
fail_parsing : String → ByteParser result_type
fail_parsing error_message = MkByteParser $ \current_parser_state =>
  Left (parse_error_at_byte_offset
    (parser_state_byte_offset current_parser_state)
    error_message)

public export
require_parser_condition : Bool → String → ByteParser ()
require_parser_condition True _ = pure ()
require_parser_condition False error_message = fail_parsing error_message

public export
get_current_parser_state : ByteParser parser_state
get_current_parser_state =
  MkByteParser $ \current_parser_state => Right (current_parser_state, current_parser_state)

public export
get_current_byte_offset : ByteParser Nat
get_current_byte_offset = map parser_state_byte_offset get_current_parser_state

public export
peek_next_byte : ByteParser (Maybe Bits8)
peek_next_byte = MkByteParser $ \current_parser_state =>
  case parser_state_remaining_bytes current_parser_state of
    [] => Right (Nothing, current_parser_state)
    next_byte :: _ => Right (Just next_byte, current_parser_state)

public export
read_next_byte : ByteParser Bits8
read_next_byte = MkByteParser $ \current_parser_state =>
  case current_parser_state of
    parser_state_with_remaining_bytes [] byte_offset =>
      Left (parse_error_at_byte_offset byte_offset "end of input")
    parser_state_with_remaining_bytes (next_byte :: remaining_bytes) byte_offset =>
      Right (
        next_byte,
        parser_state_with_remaining_bytes remaining_bytes (S byte_offset))

public export
read_byte_satisfying : String → (Bits8 → Bool) → ByteParser Bits8
read_byte_satisfying expected_description condition =
  MkByteParser $ \current_parser_state =>
    case current_parser_state of
      parser_state_with_remaining_bytes [] byte_offset =>
        Left (parse_error_at_byte_offset byte_offset
          ("expected " ++ expected_description ++ ", found end of input"))
      parser_state_with_remaining_bytes (next_byte :: remaining_bytes) byte_offset =>
        if condition next_byte
          then Right (
            next_byte,
            parser_state_with_remaining_bytes remaining_bytes (S byte_offset))
          else Left (parse_error_at_byte_offset byte_offset
            ("expected " ++ expected_description ++ ", found byte " ++ show next_byte))

public export
require_byte : Bits8 → ByteParser ()
require_byte expected_byte = do
  _ <- read_byte_satisfying ("byte " ++ show expected_byte) (== expected_byte)
  pure ()

public export
require_bytes : List Bits8 → ByteParser ()
require_bytes [] = pure ()
require_bytes (expected_byte :: remaining_expected_bytes) = do
  require_byte expected_byte
  require_bytes remaining_expected_bytes

public export
read_exactly_bytes : (byte_count : Nat) → ByteParser (Vect byte_count Bits8)
read_exactly_bytes Z = pure []
read_exactly_bytes (S remaining_byte_count) = do
  next_byte <- read_next_byte
  remaining_bytes <- read_exactly_bytes remaining_byte_count
  pure (next_byte :: remaining_bytes)

public export
read_bytes_while : (Bits8 → Bool) → ByteParser (List Bits8)
read_bytes_while condition = MkByteParser $ \current_parser_state =>
  let (matching_bytes, remaining_bytes) =
        span condition (parser_state_remaining_bytes current_parser_state)
      consumed_byte_count = length matching_bytes
  in Right (
    matching_bytes,
    parser_state_with_remaining_bytes
      remaining_bytes
      (parser_state_byte_offset current_parser_state + consumed_byte_count))

public export
skip_bytes_while : (Bits8 → Bool) → ByteParser ()
skip_bytes_while condition = map (const ()) (read_bytes_while condition)

public export
require_end_of_input : ByteParser ()
require_end_of_input = do
  possible_next_byte <- peek_next_byte
  case possible_next_byte of
    Nothing => pure ()
    Just next_byte =>
      fail_parsing ("expected end of input, found byte " ++ show next_byte)
