module PDF.Types

-- Edriç source. This file classifies PDF types without yet choosing runtime
-- representations for their values.
--
-- Manual provenance is recorded in:
--   notes/pdf-data-types.md §0 "Source record"
--   notes/pdf-type-source.md
-- The source was consulted on 2026-08-23 against ISO 32000-2:2020 Clause 7
-- with the PDF Association resolved errata current on that date.

public export
choice pdf_basic_type one_of
  -- notes/pdf-data-types.md §1 → "Boolean"; ISO 32000-2:2020 §7.3.2.
  basic_boolean
  -- notes/pdf-data-types.md §1 → "Integer"; ISO 32000-2:2020 §7.3.3.
  basic_integer
  -- notes/pdf-data-types.md §1 → "Real"; ISO 32000-2:2020 §7.3.3.
  basic_real
  -- notes/pdf-data-types.md §1 → "String"; ISO 32000-2:2020 §7.3.4.
  basic_string
  -- notes/pdf-data-types.md §1 → "Name"; ISO 32000-2:2020 §7.3.5.
  basic_name
  -- notes/pdf-data-types.md §1 → "Array"; ISO 32000-2:2020 §7.3.6.
  basic_array
  -- notes/pdf-data-types.md §1 → "Dictionary"; ISO 32000-2:2020 §7.3.7.
  basic_dictionary
  -- notes/pdf-data-types.md §1 → "Stream"; ISO 32000-2:2020 §7.3.8.
  basic_stream
  -- notes/pdf-data-types.md §1 → "Null"; ISO 32000-2:2020 §7.3.9.
  basic_null

-- This second choice mirrors the names in ISO 32000-2:2020 §7.9.1,
-- Table 35 "PDF data types" (informative), including resolved errata.
public export
choice pdf_data_type one_of
  -- notes/pdf-data-types.md §4 → "ASCII string".
  data_ascii_string
  -- notes/pdf-data-types.md §4 → "Array".
  data_array
  -- notes/pdf-data-types.md §4 → "Boolean".
  data_boolean
  -- notes/pdf-data-types.md §4 → "Byte string".
  data_byte_string
  -- notes/pdf-data-types.md §4 → "Date".
  data_date
  -- notes/pdf-data-types.md §4 → "Dictionary".
  data_dictionary
  -- notes/pdf-data-types.md §4 → "File specification".
  data_file_specification
  -- notes/pdf-data-types.md §4 → "Function".
  data_function
  -- notes/pdf-data-types.md §4 → "Integer".
  data_integer
  -- notes/pdf-data-types.md §4 → "Name".
  data_name
  -- notes/pdf-data-types.md §4 → "Name tree".
  data_name_tree
  -- notes/pdf-data-types.md §4 → "Null".
  data_null
  -- notes/pdf-data-types.md §4 → "Number".
  data_number
  -- notes/pdf-data-types.md §4 → "Number tree".
  data_number_tree
  -- notes/pdf-data-types.md §4 → "PDFDocEncoded string".
  data_pdfdocencoded_string
  -- notes/pdf-data-types.md §4 → "Rectangle".
  data_rectangle
  -- notes/pdf-data-types.md §4 → "Stream".
  data_stream
  -- notes/pdf-data-types.md §4 → "String".
  data_string
  -- notes/pdf-data-types.md §4 → "Text string".
  data_text_string
  -- notes/pdf-data-types.md §4 → "Text stream".
  data_text_stream

-- These are parser-visible structural forms, not additional basic PDF value
-- types. See notes/pdf-data-types.md §3.
public export
choice pdf_object_structure one_of
  -- notes/pdf-data-types.md §3 → "Direct object".
  direct_object
  -- notes/pdf-data-types.md §3 → "Indirect object"; ISO 32000-2:2020 §7.3.10.
  indirect_object
  -- notes/pdf-data-types.md §3 → "Indirect reference"; ISO 32000-2:2020 §7.3.10.
  indirect_reference
